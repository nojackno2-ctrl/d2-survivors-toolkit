{
  "name": "d2-survivors-save-editor",
  "productName": "D2倖存者存檔修改器",
  "version": "1.0.13",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "classic-level": "1.4.1",
    "ws": "^8.23.0",
    "@electron/asar": "^3.2.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.d2survivors.saveeditor",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "engine.js",
      "paths.js",
      "game-link.js",
      "launcher-api.js",
      "launcher.html",
      "lang-cli.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../modifier",
        "to": "modifier"
      },
      {
        "from": "../guard",
        "to": "guard"
      },
      {
        "from": "../helper",
        "to": "helper"
      },
      {
        "from": "../lang/zh-TW.json",
        "to": "lang/zh-TW.json"
      },
      {
        "from": "../lang/desktop-lang-core.mjs",
        "to": "lang/desktop-lang-core.mjs"
      },
      {
        "from": "../lang/d2rfont.js",
        "to": "lang/d2rfont.js"
      }
    ],
    "asarUnpack": [
      "node_modules/classic-level/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "D2倖存者存檔修改器.exe"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
